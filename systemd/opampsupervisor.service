[Unit]
Description=OpenTelemetry OpAMP Supervisor managed by FleetAMP
Documentation=https://fleetamp.marellasunil.com/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=otel
Group=otel
ExecStart=/opt/opampsupervisor/opampsupervisor --config /etc/opampsupervisor/supervisor.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
UMask=0077

# Persist the Supervisor identity and last known configuration.
StateDirectory=opampsupervisor
StateDirectoryMode=0700

# Conservative pilot guardrails; tune through enterprise capacity testing.
MemoryMax=512M
TasksMax=128

# Service hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opampsupervisor
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
